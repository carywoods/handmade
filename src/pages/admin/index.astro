---
import Layout from '../../layouts/Layout.astro';
import { isAdminAuthenticated } from '../../lib/auth';
import { getAdminStats, getItems } from '../../lib/db';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login', 302);
}

const stats = getAdminStats();
const { items: allItems } = getItems({ activeOnly: false, limit: 100 });

const actionStatus = Astro.url.searchParams.get('status');
const actionMsg = Astro.url.searchParams.get('msg');
---

<Layout title="Operator Dashboard | its made by hand">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Top Bar: Header & Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-warm-200">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-xs uppercase font-bold tracking-wider text-warm-800/80">Active Control Plane</span>
        </div>
        <h1 class="text-3xl font-serif text-warm-900 mt-1">Platform Operations</h1>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/"
          target="_blank"
          class="px-4 py-2 rounded-xl bg-white border border-warm-200 text-xs font-semibold text-warm-800 hover:bg-warm-100 transition-colors shadow-xs"
        >
          View Storefront ↗
        </a>
        <form action="/api/admin/auth" method="POST">
          <input type="hidden" name="action" value="logout" />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-warm-200/80 hover:bg-warm-300 text-xs font-semibold text-warm-900 transition-colors"
          >
            Sign Out
          </button>
        </form>
      </div>
    </div>

    <!-- Alert Notifications -->
    {actionStatus === 'success' && (
      <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>Operation completed successfully. Database and stats refreshed.</span>
      </div>
    )}

    {actionStatus === 'error' && (
      <div class="p-4 bg-red-50 border border-red-200 text-red-800 text-xs rounded-xl flex items-center gap-2">
        <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span>Error executing operation: {actionMsg || 'Unknown error'}</span>
      </div>
    )}

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- Total Page Views -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-xs uppercase font-bold tracking-wider text-warm-800/70">Total Page Views</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.totalViews}</span>
          <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
            +{stats.viewsToday} 24h
          </span>
        </div>
        <p class="text-[11px] text-warm-800/60 pt-2">Tracked client-side page impressions</p>
      </div>

      <!-- Outbound Clicks -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-xs uppercase font-bold tracking-wider text-warm-800/70">Affiliate Clicks</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-clay-600">{stats.totalClicks}</span>
          <span class="text-xs font-semibold text-clay-700 bg-clay-50 px-2 py-0.5 rounded-full">
            +{stats.clicksToday} 24h
          </span>
        </div>
        <p class="text-[11px] text-warm-800/60 pt-2">Outbound referral clicks to Amazon</p>
      </div>

      <!-- Active Catalog Items -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-xs uppercase font-bold tracking-wider text-warm-800/70">Active Artisan Goods</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.activeItems}</span>
          <span class="text-xs text-warm-800/70">of {stats.totalItems} total</span>
        </div>
        <p class="text-[11px] text-warm-800/60 pt-2">
          {stats.inactiveItems > 0 ? `${stats.inactiveItems} flagged inactive` : 'All items reachable'}
        </p>
      </div>

      <!-- Ingestion & Rot Scan Status -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-2">
        <span class="text-xs uppercase font-bold tracking-wider text-warm-800/70">Maintenance Status</span>
        <div class="text-xs space-y-1.5">
          <div class="flex justify-between">
            <span class="text-warm-800/80">Link Scan:</span>
            <span class="font-medium text-warm-900">
              {stats.lastLinkRotCheck ? new Date(stats.lastLinkRotCheck.created_at).toLocaleDateString() : 'Pending'}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-warm-800/80">Ingestion:</span>
            <span class="font-medium text-warm-900">
              {stats.lastIngestion ? new Date(stats.lastIngestion.created_at).toLocaleDateString() : 'Pending'}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-warm-800/80">Live Scraper:</span>
            <span class="font-medium text-clay-700 font-semibold">
              {stats.lastScraper ? new Date(stats.lastScraper.created_at).toLocaleDateString() : 'Ready'}
            </span>
          </div>
        </div>
      </div>

    </div>

    <!-- Live Amazon Handmade Scraper Panel -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-warm-100 pb-4">
        <div>
          <h2 class="text-lg font-serif text-warm-900 flex items-center gap-2">
            <span>Amazon Handmade Scraper & Catalog Loader</span>
            <span class="text-[10px] uppercase tracking-wider font-bold bg-clay-100 text-clay-800 px-2 py-0.5 rounded-full">
              Live Ingest
            </span>
          </h2>
          <p class="text-xs text-warm-800/70">
            Crawl live Amazon Handmade listings, vet craftsmanship through our authenticity filter, and upsert directly into SQLite.
          </p>
        </div>
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-scraper" />
          <input type="hidden" name="limit" value="4" />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-clay-600 hover:bg-clay-700 text-white text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-all"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Scrape All 5 Categories Now
          </button>
        </form>
      </div>

      <!-- Targeted Search Scraper & Direct ASIN Importer -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        
        <!-- Custom Query Form -->
        <form action="/api/admin/action" method="POST" class="p-4 rounded-xl bg-warm-50/80 border border-warm-200 space-y-3">
          <input type="hidden" name="action" value="scrape-query" />
          <div>
            <label class="block text-xs font-bold text-warm-900 uppercase tracking-wider mb-1">
              Search Term Scraper
            </label>
            <input
              type="text"
              name="query"
              required
              placeholder="e.g. handmade walnut cutting board"
              class="w-full px-3 py-2 text-xs rounded-lg border border-warm-300 bg-white focus:outline-none focus:ring-2 focus:ring-clay-500/40"
            />
          </div>
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 text-xs text-warm-800/80">
              <span>Items to fetch:</span>
              <select name="limit" class="px-2 py-1 bg-white border border-warm-300 rounded text-xs">
                <option value="3">3</option>
                <option value="6" selected>6</option>
                <option value="12">12</option>
              </select>
            </div>
            <button
              type="submit"
              class="px-3.5 py-1.5 rounded-lg bg-warm-900 hover:bg-black text-white text-xs font-semibold tracking-wide transition-colors"
            >
              Scrape & Import
            </button>
          </div>
        </form>

        <!-- Direct ASIN Importer Form -->
        <form action="/api/admin/action" method="POST" class="p-4 rounded-xl bg-warm-50/80 border border-warm-200 space-y-3">
          <input type="hidden" name="action" value="scrape-asins" />
          <div>
            <label class="block text-xs font-bold text-warm-900 uppercase tracking-wider mb-1">
              Direct ASIN Importer
            </label>
            <input
              type="text"
              name="asins"
              required
              placeholder="e.g. B0BW4LD35T, B00PMF383O"
              class="w-full px-3 py-2 text-xs rounded-lg border border-warm-300 bg-white focus:outline-none focus:ring-2 focus:ring-clay-500/40 font-mono"
            />
          </div>
          <div class="flex items-center justify-end">
            <button
              type="submit"
              class="px-3.5 py-1.5 rounded-lg bg-warm-800 hover:bg-warm-900 text-white text-xs font-semibold tracking-wide transition-colors"
            >
              Fetch & Ingest ASINs
            </button>
          </div>
        </form>

      </div>
    </div>

    <!-- Manual Operator Trigger Bar -->
    <div class="p-6 rounded-2xl bg-warm-100/80 border border-warm-200 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-serif text-warm-900">Maintenance & Hygiene Controls</h2>
          <p class="text-xs text-warm-800/70">Run link rot scans, seed data, or purge de-listed items from SQLite.</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <!-- Trigger Ingestion -->
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-ingestion" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-warm-900 hover:bg-black text-white text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-clay-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Trigger Monthly Ingestion Worker
          </button>
        </form>

        <!-- Trigger Rot Check -->
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-rot-check" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-warm-200/70 text-warm-900 border border-warm-300 text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Run Weekly Link-Rot Scan
          </button>
        </form>

        <!-- Prune Inactive -->
        <form action="/api/admin/action" method="POST" onsubmit="return confirm('Are you sure you want to permanently prune all inactive items from SQLite?');">
          <input type="hidden" name="action" value="prune-inactive" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-red-50 text-red-700 border border-red-200 text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Prune Inactive ({stats.inactiveItems})
          </button>
        </form>
      </div>
    </div>

    <!-- Category Breakdown & Top Clicked Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Category Breakdown Table -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
        <h3 class="text-base font-serif text-warm-900">Category Distribution</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
                <th class="pb-2 font-semibold">Category</th>
                <th class="pb-2 font-semibold text-center">Active</th>
                <th class="pb-2 font-semibold text-center">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-warm-100">
              {stats.categoryBreakdown.map((cat) => (
                <tr>
                  <td class="py-2.5 font-medium text-warm-900">{cat.category}</td>
                  <td class="py-2.5 text-center text-emerald-700 font-semibold">{cat.active}</td>
                  <td class="py-2.5 text-center text-warm-800/70">{cat.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Top Clicked Products -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
        <h3 class="text-base font-serif text-warm-900">Top Outbound Referral Items</h3>
        {stats.topClickedItems.length === 0 ? (
          <p class="text-xs text-warm-800/60 py-6 text-center">No outbound clicks recorded yet.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
                  <th class="pb-2 font-semibold">Item</th>
                  <th class="pb-2 font-semibold">Category</th>
                  <th class="pb-2 font-semibold text-right">Clicks</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-warm-100">
                {stats.topClickedItems.map((clk) => (
                  <tr>
                    <td class="py-2.5 font-medium text-warm-900 truncate max-w-[200px]" title={clk.title}>
                      <a href={`/item/${clk.asin}`} class="hover:text-clay-600 underline decoration-warm-300">
                        {clk.title}
                      </a>
                    </td>
                    <td class="py-2.5 text-warm-800/80">{clk.category}</td>
                    <td class="py-2.5 text-right font-bold text-clay-600">{clk.click_count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

    </div>

    <!-- Catalog Management Table -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-serif text-warm-900">Catalog Inventory ({allItems.length})</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
              <th class="pb-2.5 font-semibold">ASIN</th>
              <th class="pb-2.5 font-semibold">Item & Maker</th>
              <th class="pb-2.5 font-semibold">Category</th>
              <th class="pb-2.5 font-semibold">Price</th>
              <th class="pb-2.5 font-semibold text-center">Status</th>
              <th class="pb-2.5 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            {allItems.map((item) => (
              <tr class={item.is_active ? '' : 'bg-red-50/40'}>
                <td class="py-3 font-mono text-[11px] text-warm-800/80">{item.asin}</td>
                <td class="py-3">
                  <a href={`/item/${item.asin}`} class="font-medium text-warm-900 hover:text-clay-600 block line-clamp-1">
                    {item.title}
                  </a>
                  <span class="text-[11px] text-warm-800/60 block">{item.artisan_name || 'Independent Artisan'}</span>
                </td>
                <td class="py-3 text-warm-800">{item.category}</td>
                <td class="py-3 font-medium text-warm-900">${item.price_approx?.toFixed(2) || '—'}</td>
                <td class="py-3 text-center">
                  <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    item.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
                  }`}>
                    {item.is_active ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="py-3 text-right">
                  <form action="/api/admin/action" method="POST" class="inline">
                    <input type="hidden" name="action" value="toggle-item" />
                    <input type="hidden" name="id" value={item.id} />
                    <button
                      type="submit"
                      class="text-[11px] font-medium text-warm-800 hover:text-clay-700 underline"
                    >
                      {item.is_active ? 'Deactivate' : 'Activate'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent System Logs -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
      <h3 class="text-base font-serif text-warm-900">Recent Automation Logs</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
              <th class="pb-2 font-semibold">Timestamp</th>
              <th class="pb-2 font-semibold">Event</th>
              <th class="pb-2 font-semibold">Status</th>
              <th class="pb-2 font-semibold">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            {stats.recentLogs.map((log) => (
              <tr>
                <td class="py-2.5 text-warm-800/70 font-mono text-[11px]">
                  {new Date(log.created_at).toLocaleString()}
                </td>
                <td class="py-2.5 font-medium text-warm-900">{log.event_type}</td>
                <td class="py-2.5">
                  <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    log.status === 'success'
                      ? 'bg-emerald-100 text-emerald-800'
                      : log.status === 'warning'
                      ? 'bg-amber-100 text-amber-800'
                      : 'bg-red-100 text-red-800'
                  }`}>
                    {log.status}
                  </span>
                </td>
                <td class="py-2.5 text-warm-800/80 text-[11px] max-w-md truncate" title={log.details}>
                  {log.details}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</Layout>
