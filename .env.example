# itsmadebyhand.com Environment Configuration

# Amazon Associates Tracking Tag (Mandatory for affiliate monetization)
AMAZON_TAG=itsmadebyha0a-20

# Admin Dashboard Password (Used to authenticate at /admin)
ADMIN_PASSWORD=your_secure_admin_passphrase_here

# Server Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Gemini API Key (Used for multimodal AI vision evaluation of product photos & authenticity)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Amazon PA-API Credentials (for expanded automated live queries)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=us-east-1

# Optional: Third-Party Analytics (Disabled by default; internal SQLite first-party analytics always runs)
# PUBLIC_GA_ID=G-XXXXXXXXXX
# PUBLIC_PLAUSIBLE_DOMAIN=itsmadebyhand.com
# PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PUBLIC_UMAMI_HOST=https://cloud.umami.is
