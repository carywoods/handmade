---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getItems } from '../../lib/db';

const { category: slug } = Astro.params;

const CATEGORY_MAP: Record<string, { name: string; description: string }> = {
  'woodworking': {
    name: 'Woodworking',
    description: 'Heirloom end-grain cutting boards, live-edge serving trays, and turned timber crafts hand-shaped from sustainably harvested hardwoods.',
  },
  'pottery-ceramics': {
    name: 'Pottery & Ceramics',
    description: 'Wheel-thrown stoneware mugs, fluted terracotta planters, and unglazed tableware forged through high-fire kilns.',
  },
  'leather-goods': {
    name: 'Leather Goods',
    description: 'Full-grain vegetable-tanned wallets, saddle-stitched journals, and solid brass accessories designed to patina beautifully with age.',
  },
  'textiles': {
    name: 'Textiles',
    description: 'Washed flax linen throws, hand-dyed indigo runners, and chunky merino wool knits crafted using traditional weaving techniques.',
  },
  'home-living': {
    name: 'Home & Living',
    description: 'Hand-dipped pure beeswax candles, hand-forged blacksmith hardware, and artisan home accents made with natural materials.',
  },
};

const categoryInfo = (slug && CATEGORY_MAP[slug]) || {
  name: slug ? slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : 'Category',
  description: 'Authentic handmade creations by verified independent craftspeople.',
};

const { items, total } = getItems({
  category: categoryInfo.name,
  activeOnly: true,
  limit: 48,
});
---

<Layout
  title={`${categoryInfo.name} | its made by hand`}
  description={categoryInfo.description}
  currentCategory={slug}
>
  <!-- Category Header -->
  <section class="bg-warm-100/70 border-b border-warm-200/80 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-warm-800/70 mb-4">
        <a href="/" class="hover:text-clay-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-warm-900 font-medium">{categoryInfo.name}</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-warm-900 tracking-tight">
          {categoryInfo.name}
        </h1>
        <p class="mt-4 text-sm sm:text-base text-warm-800/80 leading-relaxed max-w-2xl">
          {categoryInfo.description}
        </p>
        <div class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-clay-700 bg-white/80 px-3 py-1 rounded-full border border-warm-200/70">
          <span>{total} Verified Pieces Available</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Items Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {items.length === 0 ? (
      <div class="py-16 text-center bg-white rounded-2xl border border-warm-200 p-8">
        <h3 class="font-serif text-xl text-warm-900 mb-2">No items found in this category</h3>
        <p class="text-xs text-warm-800/70 max-w-sm mx-auto mb-6">
          Check back after our next monthly artisan ingestion scan, or explore another craft.
        </p>
        <a
          href="/"
          class="inline-block px-5 py-2.5 rounded-full bg-clay-600 hover:bg-clay-700 text-white text-xs font-semibold tracking-wide transition-colors"
        >
          Explore All Categories
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8">
        {items.map((item) => (
          <ProductCard item={item} />
        ))}
      </div>
    )}
  </section>
</Layout>
