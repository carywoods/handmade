---
import Layout from '../../layouts/Layout.astro';
import { isAdminAuthenticated } from '../../lib/auth';

if (isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin', 302);
}

const hasError = Astro.url.searchParams.get('error') === 'invalid_password';
---

<Layout title="Operator Login | its made by hand">
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md bg-white rounded-2xl border border-warm-200 shadow-lg p-8 space-y-6">
      
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-xl bg-warm-100 border border-warm-200 flex items-center justify-center mx-auto text-clay-600">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-2xl font-serif text-warm-900">Operator Access</h1>
        <p class="text-xs text-warm-800/70">
          Enter your admin passphrase to access catalog metrics and worker controls.
        </p>
      </div>

      {hasError && (
        <div class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span>Incorrect administrator password. Please try again.</span>
        </div>
      )}

      <form action="/api/admin/auth" method="POST" class="space-y-4">
        <div>
          <label for="password" class="block text-xs font-semibold text-warm-800 uppercase tracking-wider mb-1.5">
            Admin Password
          </label>
          <input
            id="password"
            type="password"
            name="password"
            required
            autofocus
            placeholder="••••••••••••"
            class="w-full px-4 py-2.5 rounded-xl border border-warm-300 text-sm text-warm-900 focus:outline-none focus:ring-2 focus:ring-clay-500/40 focus:border-clay-500"
          />
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-warm-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider transition-colors shadow-xs"
        >
          Authenticate
        </button>
      </form>

      <div class="text-center">
        <a href="/" class="text-xs text-warm-800/70 hover:text-clay-600 transition-colors">
          &larr; Return to public marketplace
        </a>
      </div>

    </div>
  </div>
</Layout>
