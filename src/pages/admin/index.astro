---
import Layout from '../../layouts/Layout.astro';
import { isAdminAuthenticated } from '../../lib/auth';
import { getAdminStats, getItems } from '../../lib/db';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login', 302);
}

const stats = getAdminStats();
const { items: allItems } = getItems({ activeOnly: false, limit: 100 });

const actionStatus = Astro.url.searchParams.get('status');
const actionMsg = Astro.url.searchParams.get('msg');

// Detect optional external analytics
const activeExternalAnalytics: string[] = [];
// @ts-ignore
const gaId = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_GA_ID) || process.env.PUBLIC_GA_ID;
if (gaId) activeExternalAnalytics.push(`GA4 (${gaId})`);
// @ts-ignore
const plausibleDomain = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_PLAUSIBLE_DOMAIN) || process.env.PUBLIC_PLAUSIBLE_DOMAIN;
if (plausibleDomain) activeExternalAnalytics.push(`Plausible (${plausibleDomain})`);
// @ts-ignore
const umamiId = (typeof import.meta !== 'undefined' && import.meta.env?.PUBLIC_UMAMI_WEBSITE_ID) || process.env.PUBLIC_UMAMI_WEBSITE_ID;
if (umamiId) activeExternalAnalytics.push(`Umami (${umamiId.slice(0, 8)}...)`);
---

<Layout title="Operator Dashboard | its made by hand">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Top Bar: Header & Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-warm-200">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-xs uppercase font-bold tracking-wider text-warm-800/80">Active Control Plane</span>
        </div>
        <h1 class="text-3xl font-serif text-warm-900 mt-1">Platform Operations</h1>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/"
          target="_blank"
          class="px-4 py-2 rounded-xl bg-white border border-warm-200 text-xs font-semibold text-warm-800 hover:bg-warm-100 transition-colors shadow-xs"
        >
          View Storefront ↗
        </a>
        <form action="/api/admin/auth" method="POST">
          <input type="hidden" name="action" value="logout" />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-warm-200/80 hover:bg-warm-300 text-xs font-semibold text-warm-900 transition-colors"
          >
            Sign Out
          </button>
        </form>
      </div>
    </div>

    <!-- Alert Notifications -->
    {actionStatus === 'success' && (
      <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>Operation completed successfully. Database and stats refreshed.</span>
      </div>
    )}

    {actionStatus === 'error' && (
      <div class="p-4 bg-red-50 border border-red-200 text-red-800 text-xs rounded-xl flex items-center gap-2">
        <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span>Error executing operation: {actionMsg || 'Unknown error'}</span>
      </div>
    )}

    <!-- KPI Metric Cards (5 Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Total Page Views -->
      <div class="p-5 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-[11px] uppercase font-bold tracking-wider text-warm-800/70">Page Views</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.totalViews}</span>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            +{stats.viewsToday} 24h
          </span>
        </div>
        <p class="text-[10px] text-warm-800/60 pt-1">Filtered against search bots</p>
      </div>

      <!-- Unique Visitors -->
      <div class="p-5 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-[11px] uppercase font-bold tracking-wider text-warm-800/70">Unique Visitors</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.uniqueVisitors}</span>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            +{stats.uniqueVisitorsToday} 24h
          </span>
        </div>
        <p class="text-[10px] text-warm-800/60 pt-1">Anonymous device fingerprints</p>
      </div>

      <!-- Outbound Clicks -->
      <div class="p-5 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-[11px] uppercase font-bold tracking-wider text-warm-800/70">Affiliate Clicks</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-clay-600">{stats.totalClicks}</span>
          <span class="text-[11px] font-semibold text-clay-700 bg-clay-50 px-2 py-0.5 rounded-full">
            +{stats.clicksToday} 24h
          </span>
        </div>
        <p class="text-[10px] text-warm-800/60 pt-1">Amazon referral exits</p>
      </div>

      <!-- Conversion Rate (CTR) -->
      <div class="p-5 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-[11px] uppercase font-bold tracking-wider text-warm-800/70">Click-Through Rate</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.overallCtr}%</span>
          <span class="text-[11px] font-semibold text-warm-800 bg-warm-100 px-2 py-0.5 rounded-full">
            {stats.todayCtr}% 24h
          </span>
        </div>
        <p class="text-[10px] text-warm-800/60 pt-1">Outbound click conversion</p>
      </div>

      <!-- Catalog Health -->
      <div class="p-5 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-1">
        <span class="text-[11px] uppercase font-bold tracking-wider text-warm-800/70">Catalog Health</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-serif font-bold text-warm-900">{stats.activeItems}</span>
          <span class="text-xs text-warm-800/70">of {stats.totalItems}</span>
        </div>
        <p class="text-[10px] text-warm-800/60 pt-1">
          {stats.inactiveItems > 0 ? `${stats.inactiveItems} inactive` : '100% reachable'}
        </p>
      </div>

    </div>

    <!-- Traffic Intelligence & Acquisition Analysis Section -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-6">
      <div class="border-b border-warm-100 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-lg font-serif text-warm-900 flex items-center gap-2">
            <span>Traffic & Audience Intelligence</span>
            <span class="text-[10px] uppercase tracking-wider font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
              Real-Time
            </span>
          </h2>
          <p class="text-xs text-warm-800/70">
            Privacy-first server and client telemetry measuring acquisition channels, storefront velocity, and device distribution.
          </p>
        </div>
        <div class="flex flex-col sm:items-end gap-1.5 text-xs text-warm-800/70">
          <div>Lifetime Human Impressions: <strong class="text-warm-900">{stats.totalViews}</strong></div>
          <div>
            <span class={`inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
              activeExternalAnalytics.length > 0 ? 'bg-blue-100 text-blue-800' : 'bg-warm-100 text-warm-700'
            }`}>
              3rd-Party Analytics: {activeExternalAnalytics.length > 0 ? `Active (${activeExternalAnalytics.join(', ')})` : 'Disabled (First-Party SQLite Mode)'}
            </span>
          </div>
        </div>
      </div>

      <!-- 7-Day Traffic & Conversion Velocity Table -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-warm-800">
            Recent 7-Day Traffic & Conversion Velocity
          </h3>
          <span class="text-[11px] text-warm-800/60">Day-by-day telemetry</span>
        </div>
        <div class="overflow-x-auto rounded-xl border border-warm-200/80">
          <table class="w-full text-left text-xs">
            <thead class="bg-warm-50 text-warm-800/70 uppercase tracking-wider text-[10px]">
              <tr>
                <th class="py-2.5 px-4 font-semibold">Date</th>
                <th class="py-2.5 px-4 font-semibold text-center">Page Views</th>
                <th class="py-2.5 px-4 font-semibold text-center">Unique Visitors</th>
                <th class="py-2.5 px-4 font-semibold text-center">Affiliate Clicks</th>
                <th class="py-2.5 px-4 font-semibold text-right">Conversion (CTR)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-warm-100">
              {stats.sevenDayTrend.length === 0 ? (
                <tr>
                  <td colspan="5" class="py-4 text-center text-warm-800/60">No recent traffic history recorded.</td>
                </tr>
              ) : (
                stats.sevenDayTrend.map((day) => (
                  <tr class="hover:bg-warm-50/50 transition-colors">
                    <td class="py-2.5 px-4 font-mono text-[11px] text-warm-900 font-medium">{day.date}</td>
                    <td class="py-2.5 px-4 text-center text-warm-900 font-semibold">{day.views}</td>
                    <td class="py-2.5 px-4 text-center text-warm-800/80">{day.visitors}</td>
                    <td class="py-2.5 px-4 text-center text-clay-600 font-bold">{day.clicks}</td>
                    <td class="py-2.5 px-4 text-right font-mono text-[11px] text-warm-900 font-semibold">{day.ctr}%</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Traffic Origins & Audience Intelligence (Where Traffic is Coming From) -->
      <div class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-warm-900 flex items-center gap-2">
            <span>Where Traffic Is Coming From</span>
            <span class="text-[10px] font-normal text-warm-800/60 lowercase">(geographic & referral origin)</span>
          </h3>
          <span class="text-[11px] text-warm-800/60">Global telemetry</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- 1. Geographic Origin (Countries & World Regions) -->
          <div class="p-4 rounded-xl bg-warm-50/70 border border-warm-200 space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-warm-200/60">
                <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900 flex items-center gap-1.5">
                  <span>🌍 Geographic Origin</span>
                </h4>
                <span class="text-[10px] text-warm-800/60">Visitors / Share</span>
              </div>
              <div class="space-y-2.5 pt-2.5">
                {stats.geoBreakdown.length === 0 ? (
                  <p class="text-xs text-warm-800/60 py-4 text-center">No location telemetry recorded yet.</p>
                ) : (
                  stats.geoBreakdown.map((geo) => (
                    <div>
                      <div class="flex items-center justify-between text-xs mb-1">
                        <span class="text-warm-800 font-medium flex items-center gap-1.5 truncate max-w-[170px]" title={geo.countryName}>
                          <span class="text-base leading-none">{geo.flag}</span>
                          <span class="truncate">{geo.countryName}</span>
                        </span>
                        <span class="text-warm-900 font-bold text-[11px]">
                          {geo.visitors} <span class="text-warm-800/50 font-normal">vis</span> ({geo.percent}%)
                        </span>
                      </div>
                      <div class="w-full bg-warm-200 rounded-full h-1.5">
                        <div class="bg-clay-600 h-1.5 rounded-full" style={`width: ${geo.percent}%`}></div>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>
            <div class="pt-2 border-t border-warm-200/60 text-[10px] text-warm-800/60 flex items-center justify-between">
              <span>Primary Market: <strong class="text-warm-900">{stats.geoBreakdown[0]?.countryName || 'Global'}</strong></span>
              <span>{stats.geoBreakdown.length} Countries</span>
            </div>
          </div>

          <!-- 2. Inbound Referring Domains & External Websites -->
          <div class="p-4 rounded-xl bg-warm-50/70 border border-warm-200 space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-warm-200/60">
                <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900 flex items-center gap-1.5">
                  <span>🔗 Inbound Referring Domains</span>
                </h4>
                <span class="text-[10px] text-warm-800/60">Hits / Share</span>
              </div>
              <ul class="space-y-2 pt-2.5 text-xs">
                {stats.topReferringDomains.length === 0 ? (
                  <li class="text-warm-800/60 py-4 text-center">No external referrers recorded yet.</li>
                ) : (
                  stats.topReferringDomains.map((ref) => (
                    <li class="flex items-center justify-between">
                      <span class="text-warm-800 font-mono text-[11px] truncate max-w-[170px]" title={ref.domain}>
                        {ref.domain}
                      </span>
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-warm-900">{ref.count}</span>
                        <span class="text-[10px] text-warm-800/60 w-8 text-right">({ref.percent}%)</span>
                      </div>
                    </li>
                  ))
                )}
              </ul>
            </div>
            <div class="pt-2 border-t border-warm-200/60 text-[10px] text-warm-800/60">
              Top Referring Channel: <strong class="text-warm-900">{stats.topReferrers[0]?.source || 'Direct'}</strong>
            </div>
          </div>

          <!-- 3. Acquisition Channels & Conversions by Origin -->
          <div class="p-4 rounded-xl bg-warm-50/70 border border-warm-200 space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-warm-200/60">
                <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900 flex items-center gap-1.5">
                  <span>🧭 Acquisition Channels</span>
                </h4>
                <span class="text-[10px] text-warm-800/60">Channel Share</span>
              </div>
              <ul class="space-y-2 pt-2.5 text-xs">
                {stats.topReferrers.map((ch) => (
                  <li class="flex items-center justify-between">
                    <span class="text-warm-800 truncate max-w-[160px]" title={ch.source}>{ch.source}</span>
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-warm-900">{ch.count}</span>
                      <span class="text-[10px] text-warm-800/60 w-8 text-right">({ch.percent}%)</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            {stats.clicksByOrigin.length > 0 && (
              <div class="pt-2.5 border-t border-warm-200/60">
                <div class="text-[10px] font-bold uppercase tracking-wider text-warm-800 mb-1.5">
                  Affiliate Clicks by Country
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {stats.clicksByOrigin.map((c) => (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white border border-warm-200 text-[10px] text-warm-900">
                      <span>{c.flag}</span>
                      <span>{c.countryName}:</span>
                      <strong>{c.clicks}</strong>
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

        </div>
      </div>

      <!-- UTM Marketing Campaign Attribution (if present) -->
      {stats.topCampaigns.length > 0 && (
        <div class="p-4 rounded-xl bg-warm-50/60 border border-warm-200 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900 flex items-center gap-1.5">
              <span>🎯 Inbound Marketing Campaigns (UTM Attribution)</span>
            </h4>
            <span class="text-[10px] text-warm-800/60">Source • Medium • Campaign</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-[10px] uppercase text-warm-800/70 bg-warm-100/60">
                <tr>
                  <th class="py-1.5 px-3">UTM Source</th>
                  <th class="py-1.5 px-3">Medium</th>
                  <th class="py-1.5 px-3">Campaign</th>
                  <th class="py-1.5 px-3 text-right">Views</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-warm-100">
                {stats.topCampaigns.map((camp) => (
                  <tr>
                    <td class="py-2 px-3 font-semibold text-warm-900">{camp.source}</td>
                    <td class="py-2 px-3 text-warm-800/70">{camp.medium}</td>
                    <td class="py-2 px-3 text-warm-800/70">{camp.campaign}</td>
                    <td class="py-2 px-3 text-right font-mono font-bold text-warm-900">{camp.count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Storefront Pages & Device Distribution Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        
        <!-- Top Visited Pages -->
        <div class="p-4 rounded-xl bg-warm-50/70 border border-warm-200 space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900">Top Visited Pages</h4>
            <span class="text-[10px] text-warm-800/60">Views / Visitors</span>
          </div>
          <ul class="space-y-2 text-xs">
            {stats.topPaths.map((pathItem) => (
              <li class="flex items-center justify-between">
                <a href={pathItem.path} target="_blank" class="text-warm-900 hover:text-clay-600 font-mono text-[11px] truncate max-w-[200px]" title={pathItem.path}>
                  {pathItem.path}
                </a>
                <span class="font-medium text-warm-800 text-[11px]">
                  <strong>{pathItem.views}</strong> <span class="text-warm-800/50">/</span> {pathItem.visitors}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Device Breakdown -->
        <div class="p-4 rounded-xl bg-warm-50/70 border border-warm-200 space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-warm-900">Device Distribution</h4>
            <span class="text-[10px] text-warm-800/60">Traffic Share</span>
          </div>
          <div class="space-y-2.5 text-xs pt-1">
            {stats.deviceBreakdown.map((dev) => (
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-warm-800 font-medium">{dev.device}</span>
                  <span class="text-warm-900 font-bold">{dev.count} ({dev.percent}%)</span>
                </div>
                <div class="w-full bg-warm-200 rounded-full h-1.5">
                  <div class="bg-clay-600 h-1.5 rounded-full" style={`width: ${dev.percent}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Live Amazon Handmade Scraper & ASIN Tools Panel -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-warm-100 pb-4">
        <div>
          <h2 class="text-lg font-serif text-warm-900 flex items-center gap-2">
            <span>Amazon Handmade Scraper & Catalog Loader</span>
            <span class="text-[10px] uppercase tracking-wider font-bold bg-clay-100 text-clay-800 px-2 py-0.5 rounded-full">
              Live Ingest
            </span>
          </h2>
          <p class="text-xs text-warm-800/70">
            Crawl live Amazon Handmade listings, vet craftsmanship through our authenticity filter, and upsert directly into SQLite.
          </p>
        </div>
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-scraper" />
          <input type="hidden" name="limit" value="4" />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-clay-600 hover:bg-clay-700 text-white text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-all"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Scrape All 5 Categories Now
          </button>
        </form>
      </div>

      <!-- Targeted Search Scraper, Direct ASIN Importer, and ASIN Validator -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 pt-2">
        
        <!-- Custom Query Form -->
        <form action="/api/admin/action" method="POST" class="p-4 rounded-xl bg-warm-50/80 border border-warm-200 space-y-3 flex flex-col justify-between">
          <input type="hidden" name="action" value="scrape-query" />
          <div class="space-y-2">
            <label class="block text-xs font-bold text-warm-900 uppercase tracking-wider">
              Search Term Scraper
            </label>
            <p class="text-[11px] text-warm-800/70 leading-snug">
              Search Amazon Handmade by artisan craft query and automatically filter for authentic goods.
            </p>
            <input
              type="text"
              name="query"
              required
              placeholder="e.g. handmade walnut cutting board"
              class="w-full px-3 py-2 text-xs rounded-lg border border-warm-300 bg-white focus:outline-none focus:ring-2 focus:ring-clay-500/40"
            />
          </div>
          <div class="flex items-center justify-between gap-3 pt-2">
            <div class="flex items-center gap-2 text-xs text-warm-800/80">
              <span>Limit:</span>
              <select name="limit" class="px-2 py-1 bg-white border border-warm-300 rounded text-xs">
                <option value="3">3</option>
                <option value="6" selected>6</option>
                <option value="12">12</option>
              </select>
            </div>
            <button
              type="submit"
              class="px-3.5 py-1.5 rounded-lg bg-warm-900 hover:bg-black text-white text-xs font-semibold tracking-wide transition-colors"
            >
              Scrape & Import
            </button>
          </div>
        </form>

        <!-- Direct ASIN Importer Form -->
        <form action="/api/admin/action" method="POST" class="p-4 rounded-xl bg-warm-50/80 border border-warm-200 space-y-3 flex flex-col justify-between">
          <input type="hidden" name="action" value="scrape-asins" />
          <div class="space-y-2">
            <label class="block text-xs font-bold text-warm-900 uppercase tracking-wider">
              Direct ASIN / URL Importer
            </label>
            <p class="text-[11px] text-warm-800/70 leading-snug">
              Paste comma, space, or newline separated 10-character ASINs or full Amazon product URLs.
            </p>
            <textarea
              name="asins"
              required
              rows="2"
              placeholder="B0BW4LD35T, https://amazon.com/dp/B00PMF383O"
              class="w-full px-3 py-2 text-xs rounded-lg border border-warm-300 bg-white focus:outline-none focus:ring-2 focus:ring-clay-500/40 font-mono"
            ></textarea>
          </div>
          <div class="flex items-center justify-end pt-2">
            <button
              type="submit"
              class="px-3.5 py-1.5 rounded-lg bg-warm-800 hover:bg-warm-900 text-white text-xs font-semibold tracking-wide transition-colors"
            >
              Fetch & Ingest ASINs
            </button>
          </div>
        </form>

        <!-- Interactive Live ASIN Validator & Diagnostic Inspector -->
        <div class="p-4 rounded-xl bg-warm-50/80 border border-warm-200 space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold text-warm-900 uppercase tracking-wider">
                Live ASIN Validator & Inspector
              </label>
              <span class="text-[10px] font-bold uppercase bg-clay-100 text-clay-700 px-1.5 py-0.5 rounded">
                Inspector
              </span>
            </div>
            <p class="text-[11px] text-warm-800/70 leading-snug">
              Test ASIN format validity, database catalog presence, and live Amazon product reachability.
            </p>
            <div class="flex gap-2">
              <input
                id="validator-input"
                type="text"
                placeholder="Paste ASIN or Amazon URL..."
                class="flex-1 px-3 py-2 text-xs rounded-lg border border-warm-300 bg-white focus:outline-none focus:ring-2 focus:ring-clay-500/40 font-mono"
              />
              <button
                id="validator-btn"
                type="button"
                class="px-3 py-2 bg-clay-600 hover:bg-clay-700 text-white text-xs font-semibold rounded-lg transition-colors flex-shrink-0"
              >
                Validate
              </button>
            </div>
          </div>

          <!-- Result Container -->
          <div id="validator-result" class="hidden p-3 rounded-lg border text-xs space-y-1.5 bg-white">
            <!-- Injected via JavaScript -->
          </div>
        </div>

      </div>
    </div>

    <!-- Manual Operator Trigger Bar -->
    <div class="p-6 rounded-2xl bg-warm-100/80 border border-warm-200 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-serif text-warm-900">Maintenance & Hygiene Controls</h2>
          <p class="text-xs text-warm-800/70">Run link rot scans, seed data, or purge de-listed items from SQLite.</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <!-- Trigger Ingestion -->
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-ingestion" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-warm-900 hover:bg-black text-white text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-clay-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Trigger Monthly Ingestion Worker
          </button>
        </form>

        <!-- Trigger Rot Check -->
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-rot-check" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-warm-200/70 text-warm-900 border border-warm-300 text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Run Weekly Link-Rot Scan
          </button>
        </form>

        <!-- Run AI Vision Audit -->
        <form action="/api/admin/action" method="POST">
          <input type="hidden" name="action" value="run-audit" />
          <input type="hidden" name="prune" value="false" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-purple-900 hover:bg-purple-950 text-white text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            Run AI Vision & Craft Audit
          </button>
        </form>

        <!-- Prune Inactive -->
        <form action="/api/admin/action" method="POST" onsubmit="return confirm('Are you sure you want to permanently prune all inactive items from SQLite?');">
          <input type="hidden" name="action" value="prune-inactive" />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-red-50 text-red-700 border border-red-200 text-xs font-semibold tracking-wide flex items-center gap-2 shadow-xs transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Prune Inactive ({stats.inactiveItems})
          </button>
        </form>
      </div>
    </div>

    <!-- Category Breakdown & Top Clicked Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Category Breakdown Table -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
        <h3 class="text-base font-serif text-warm-900">Category Distribution</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
                <th class="pb-2 font-semibold">Category</th>
                <th class="pb-2 font-semibold text-center">Active</th>
                <th class="pb-2 font-semibold text-center">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-warm-100">
              {stats.categoryBreakdown.map((cat) => (
                <tr>
                  <td class="py-2.5 font-medium text-warm-900">{cat.category}</td>
                  <td class="py-2.5 text-center text-emerald-700 font-semibold">{cat.active}</td>
                  <td class="py-2.5 text-center text-warm-800/70">{cat.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Top Clicked Products -->
      <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
        <h3 class="text-base font-serif text-warm-900">Top Outbound Referral Items</h3>
        {stats.topClickedItems.length === 0 ? (
          <p class="text-xs text-warm-800/60 py-6 text-center">No outbound clicks recorded yet.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
                  <th class="pb-2 font-semibold">Item</th>
                  <th class="pb-2 font-semibold">Category</th>
                  <th class="pb-2 font-semibold text-right">Clicks</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-warm-100">
                {stats.topClickedItems.map((clk) => (
                  <tr>
                    <td class="py-2.5 font-medium text-warm-900 truncate max-w-[200px]" title={clk.title}>
                      <a href={`/item/${clk.asin}`} class="hover:text-clay-600 underline decoration-warm-300">
                        {clk.title}
                      </a>
                    </td>
                    <td class="py-2.5 text-warm-800/80">{clk.category}</td>
                    <td class="py-2.5 text-right font-bold text-clay-600">{clk.click_count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

    </div>

    <!-- Catalog Management Table -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-serif text-warm-900">Catalog Inventory ({allItems.length})</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
              <th class="pb-2.5 font-semibold">ASIN</th>
              <th class="pb-2.5 font-semibold">Item & Maker</th>
              <th class="pb-2.5 font-semibold">Category</th>
              <th class="pb-2.5 font-semibold">Price</th>
              <th class="pb-2.5 font-semibold text-center">Status</th>
              <th class="pb-2.5 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            {allItems.map((item) => (
              <tr class={item.is_active ? '' : 'bg-red-50/40'}>
                <td class="py-3 font-mono text-[11px] text-warm-800/80">{item.asin}</td>
                <td class="py-3">
                  <a href={`/item/${item.asin}`} class="font-medium text-warm-900 hover:text-clay-600 block line-clamp-1">
                    {item.title}
                  </a>
                  <span class="text-[11px] text-warm-800/60 block">{item.artisan_name || 'Independent Artisan'}</span>
                </td>
                <td class="py-3 text-warm-800">{item.category}</td>
                <td class="py-3 font-medium text-warm-900">${item.price_approx?.toFixed(2) || '—'}</td>
                <td class="py-3 text-center">
                  <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    item.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
                  }`}>
                    {item.is_active ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="py-3 text-right">
                  <form action="/api/admin/action" method="POST" class="inline">
                    <input type="hidden" name="action" value="toggle-item" />
                    <input type="hidden" name="id" value={item.id} />
                    <button
                      type="submit"
                      class="text-[11px] font-medium text-warm-800 hover:text-clay-700 underline"
                    >
                      {item.is_active ? 'Deactivate' : 'Activate'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent System Logs -->
    <div class="p-6 rounded-2xl bg-white border border-warm-200 shadow-xs space-y-4">
      <h3 class="text-base font-serif text-warm-900">Recent Automation Logs</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-warm-100 text-warm-800/70 uppercase tracking-wider">
              <th class="pb-2 font-semibold">Timestamp</th>
              <th class="pb-2 font-semibold">Event</th>
              <th class="pb-2 font-semibold">Status</th>
              <th class="pb-2 font-semibold">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-100">
            {stats.recentLogs.map((log) => (
              <tr>
                <td class="py-2.5 text-warm-800/70 font-mono text-[11px]">
                  {new Date(log.created_at).toLocaleString()}
                </td>
                <td class="py-2.5 font-medium text-warm-900">{log.event_type}</td>
                <td class="py-2.5">
                  <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    log.status === 'success'
                      ? 'bg-emerald-100 text-emerald-800'
                      : log.status === 'warning'
                      ? 'bg-amber-100 text-amber-800'
                      : 'bg-red-100 text-red-800'
                  }`}>
                    {log.status}
                  </span>
                </td>
                <td class="py-2.5 text-warm-800/80 text-[11px] max-w-md truncate" title={log.details}>
                  {log.details}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    const valBtn = document.getElementById('validator-btn');
    const valInput = document.getElementById('validator-input') as HTMLInputElement | null;
    const valResult = document.getElementById('validator-result');

    async function runAsinValidation() {
      if (!valInput || !valBtn || !valResult) return;
      const raw = valInput.value.trim();
      if (!raw) return;

      valBtn.setAttribute('disabled', 'true');
      valBtn.textContent = 'Checking...';
      valResult.classList.remove('hidden');
      valResult.innerHTML = `
        <div class="flex items-center gap-2 text-warm-800">
          <svg class="animate-spin h-3.5 w-3.5 text-clay-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>Verifying ASIN format and querying Amazon product page...</span>
        </div>
      `;

      try {
        const formData = new FormData();
        formData.append('action', 'validate-asin');
        formData.append('asin', raw);

        const res = await fetch('/api/admin/action', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (!data.valid) {
          valResult.className = 'p-3 rounded-lg border border-red-200 bg-red-50 text-red-800 text-xs space-y-1';
          valResult.innerHTML = `
            <div class="flex items-center gap-1.5 font-bold text-red-700">
              <span>✕ Invalid ASIN Format</span>
            </div>
            <p class="text-[11px]">${data.reason || 'Input does not match standard 10-character alphanumeric ASIN format.'}</p>
          `;
          return;
        }

        const isLive = data.exists;
        const inDb = data.inDatabase;
        const cardBg = isLive ? 'bg-emerald-50/50 border-emerald-200' : 'bg-amber-50/50 border-amber-200';

        valResult.className = `p-3 rounded-lg border ${cardBg} text-xs space-y-2`;
        valResult.innerHTML = `
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono font-bold text-warm-900 bg-white px-2 py-0.5 rounded border border-warm-200">
              ${data.asin}
            </span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${
              isLive ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
            }">
              ${isLive ? '✓ Amazon Active' : '✕ Amazon 404 / Inactive'}
            </span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${
              inDb ? 'bg-blue-100 text-blue-800' : 'bg-warm-200 text-warm-800'
            }">
              ${inDb ? 'In Local Catalog' : 'Not in Catalog'}
            </span>
          </div>

          ${data.title ? `<div class="font-medium text-warm-900 line-clamp-2 text-[11px]">"${data.title}"</div>` : ''}

          <div class="text-[10px] text-warm-800/80">${data.reason}</div>

          ${
            isLive
              ? `
            <div class="pt-1 flex items-center justify-between border-t border-warm-200/60">
              <a href="https://www.amazon.com/dp/${data.asin}" target="_blank" class="text-clay-600 hover:underline text-[11px] font-medium">
                Open on Amazon ↗
              </a>
              <form action="/api/admin/action" method="POST" class="inline">
                <input type="hidden" name="action" value="scrape-asins" />
                <input type="hidden" name="asins" value="${data.asin}" />
                <button type="submit" class="px-2.5 py-1 bg-warm-900 hover:bg-black text-white text-[10px] font-bold rounded tracking-wide transition-colors">
                  ${inDb ? 'Re-Ingest / Refresh' : '+ 1-Click Ingest into Catalog'}
                </button>
              </form>
            </div>
          `
              : ''
          }
        `;
      } catch (err: any) {
        valResult.className = 'p-3 rounded-lg border border-red-200 bg-red-50 text-red-800 text-xs';
        valResult.textContent = `Diagnostic check failed: ${err?.message || err}`;
      } finally {
        valBtn.removeAttribute('disabled');
        valBtn.textContent = 'Validate';
      }
    }

    valBtn?.addEventListener('click', runAsinValidation);
    valInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        runAsinValidation();
      }
    });
  </script>
</Layout>
